# URL of the deployed Google Apps Script web app (ends in /exec).
# See README → "Google setup" and google-apps-script/Code.gs.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/...../exec

# Shared secret — must match SHARED_SECRET in google-apps-script/Code.gs.
# Any long random string.
GOOGLE_APP_SECRET=

# Gemini API key for the "Identify & Price" feature (Google AI Studio).
# Requires a billed project — Search grounding isn't available on free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
